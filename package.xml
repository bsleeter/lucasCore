<?xml version="1.0" encoding="utf-8"?>
<package name="lucasCore" displayName="LUCAS Core (model builder)" description="Builds LUCAS land-use and carbon models in ST-Sim from national datasets: FIA growth curves, CBM carbon parameters, spatial initial conditions, historical transitions and projections" version="1.0.0" url="https://github.com/bsleeter/lucasCore" minSyncroSimVersion="3.1.9">

	<builtFor package="stsim" version="4.5.4"/>

	<!-- =================================================================================================== -->
	<!-- PROJECT DATASHEETS                                                                                  -->
	<!-- =================================================================================================== -->

	<dataSheet name="DataSource" displayName="Data Sources (national data on disk)" dataScope="Project" isSingleRow="True">
		<!-- plain paths: these files are GBs and are read, never copied into the library; an empty sheet uses the defaults -->
		<column name="EcodivisionFile" displayName="FIA Ecodivisions (dissolved; fields StrtmId, StrtmNm) - primary strata and model lattice" dataType="String" isOptional="True" defaultValue="F:/lucas-master/Data Sources/FIA/EcoDivision_map/EcoDivisions_Dissolve.shp"/>
		<column name="FiaConditionFile" displayName="FIA Condition Carbon and Merchantable Volume (USGS .Rds)" dataType="String" isOptional="True" defaultValue="F:/lucas-master/Data Sources/FIA/USGS_carbon_density_and_merchVol_on_forest_conditions_CONUS_20240212.Rds"/>
		<column name="FiaDisturbanceFile" displayName="FIA Condition Disturbance and Treatment Codes (USGS .Rds)" dataType="String" isOptional="True" defaultValue="F:/lucas-master/Data Sources/FIA/USGS_forest_conditions_dstrbcd_and_trtcd_20240213.Rds"/>
		<column name="NlcdFolder" displayName="Annual NLCD Folder (Annual_NLCD_LndCov_year_CU_C1V0.tif)" dataType="String" isOptional="True" defaultValue="F:/lucas-master/Data Sources/NLCD/Annual NLCD"/>
		<column name="Evt2001File" displayName="LANDFIRE EVT 2001 (LF 1.0.5)" dataType="String" isOptional="True" defaultValue="F:/lucas-master/Data Sources/EVT/US_105_EVT/US_105_EVT/Tif/us_105evt.tif"/>
		<column name="Evt2016File" displayName="LANDFIRE EVT 2016 (LF 2.0.0)" dataType="String" isOptional="True" defaultValue="F:/lucas-master/Data Sources/EVT/LF2016_EVT_200_CONUS/LF2016_EVT_200_CONUS/Tif/LC16_EVT_200.tif"/>
		<column name="RcmapFile" displayName="RCMAP Vegetation Class" dataType="String" isOptional="True" defaultValue="F:/lucas-master/Data Sources/RCMAP/2001_test2_full_wtih_tree.img"/>
		<column name="CcapFile" displayName="C-CAP Land Cover 2001" dataType="String" isOptional="True" defaultValue="F:/lucas-master/Data Sources/CCAP/conus_2001_ccap_landcover_20200311.tif"/>
		<column name="StandAgeFile" displayName="NASA CMS Forest Age 1990" dataType="String" isOptional="True" defaultValue="F:/lucas-master/Data Sources/Stand Age/cms_age_1990.tif"/>
		<column name="MtbsSeverityFolder" displayName="MTBS Burn Severity Folder (mtbs_CONUS_year.tif)" dataType="String" isOptional="True" defaultValue="F:/lucas-master/Data Sources/MTBS/Burn Severity"/>
		<column name="LandfireDisturbanceFolder" displayName="LANDFIRE Disturbance Folder (US_DISTyear)" dataType="String" isOptional="True" defaultValue="F:/lucas-master/Data Sources/Landfire Disturbance"/>
		<column name="FriFile" displayName="LANDFIRE Mean Fire Return Interval" dataType="String" isOptional="True" defaultValue="F:/lucas-master/Data Sources/FRI/Tif/LC16_FRI_200.tif"/>
		<column name="PrismFolder" displayName="PRISM Folder (annual and normals)" dataType="String" isOptional="True" defaultValue="F:/lucas-master/Data Sources/Climate/prism"/>
		<column name="Loca2Folder" displayName="LOCA2 Folder (gcm/r1i1p1f1/ssp)" dataType="String" isOptional="True" defaultValue="F:/lucas-master/Data Sources/Climate/LOCA2"/>
		<column name="SoilCarbonFile" displayName="gSSURGO Soil Organic Carbon" dataType="String" isOptional="True" defaultValue="F:/lucas-master/Data Sources/gSSURGO/gssurgo_soc_0_999.tif"/>
		<column name="FirePerimeterHistoryFile" displayName="Interagency Fire Perimeter History" dataType="String" isOptional="True" defaultValue="F:/lucas-master/Data Sources/NIFS/InterAgencyFirePerimeterHistory_All_Years_View/InterAgencyFirePerimeterHistory_All_Years_View.shp"/>
	</dataSheet>

	<dataSheet name="StratumSource" displayName="Stratum Sources (secondary and tertiary strata)" dataScope="Project">
		<!-- written by tools/new-library.R from a preset (defaults/strata/presets.csv); edit a row and run new-library.R with the rebuild-strata flag to
		     change it. The stsim Secondary and Tertiary Strata lists are made from these rows; stages cannot write project lists. -->
		<column name="Level" dataType="String"/>
		<column name="Preset" displayName="Preset or Name" dataType="String"/>
		<column name="File" displayName="Polygon File" dataType="String"/>
		<column name="Layer" dataType="String" isOptional="True"/>
		<column name="IdField" displayName="Id Field (numeric)" dataType="String" isOptional="True"/>
		<column name="NameTemplate" displayName="Name Template ({field})" dataType="String" isOptional="True"/>
		<column name="ValueField" displayName="Value Field (with crosswalk)" dataType="String" isOptional="True"/>
		<column name="CrosswalkFile" displayName="Crosswalk File (Value, Id)" dataType="String" isOptional="True"/>
		<column name="ListFile" displayName="List File (Name, Id)" dataType="String" isOptional="True"/>
		<column name="Dissolve" dataType="Boolean" isOptional="True"/>
		<column name="Overlap" displayName="Overlap Rule" dataType="String" isOptional="True"/>
		<column name="Fill" displayName="Fill Uncovered Land" dataType="String" isOptional="True"/>
		<column name="FillDistance" displayName="Modal Fill Distance (m)" dataType="Double" isOptional="True"/>
		<column name="DefaultId" displayName="Default Id" dataType="Integer" isOptional="True"/>
		<validation validationType="Unique" columns="Level"/>
	</dataSheet>

	<!-- =================================================================================================== -->
	<!-- SCENARIO DATASHEETS                                                                                 -->
	<!-- =================================================================================================== -->

	<dataSheet name="BuildOptions" displayName="Build Options" isSingleRow="True">
		<column name="Resolution" displayName="Cell Size (m)" dataType="Integer" defaultValue="1000" validationType="WholeNumber" validationCondition="Greater" formula1="0"/>
		<column name="StudyAreaUnits" displayName="Study Area (secondary strata names, comma-separated; blank = all)" dataType="String" isOptional="True"/>
		<column name="StartYear" displayName="Historical Start Year" dataType="Integer" defaultValue="1985" validationType="WholeNumber" validationCondition="GreaterEqual" formula1="1985"/>
		<column name="EndYear" displayName="Historical End Year" dataType="Integer" defaultValue="2023" validationType="WholeNumber" validationCondition="GreaterEqual" formula1="1985"/>
			</dataSheet>

	<dataSheet name="GrowthOptions" displayName="Growth Curve Options" isSingleRow="True">
		<column name="LagYears" displayName="Fixed Lag Before Merchantable Volume (yr; blank = fitted per forest type)" dataType="Double" isOptional="True" validationType="Decimal" validationCondition="GreaterEqual" formula1="0"/>
		<column name="MinPlotsLag" displayName="Minimum Plots to Fit a Forest Type's Own Lag (else its class lag)" dataType="Integer" defaultValue="2000" validationType="WholeNumber" validationCondition="GreaterEqual" formula1="1"/>
		<column name="MaximumLag" displayName="Maximum Fitted Lag (yr)" dataType="Double" defaultValue="40" validationType="Decimal" validationCondition="Greater" formula1="0"/>
		<column name="Penalty" displayName="Pull Toward the Type's CONUS Curve (lambda)" dataType="Double" defaultValue="0.01" validationType="Decimal" validationCondition="GreaterEqual" formula1="0"/>
		<column name="MinPlotsEcodivision" displayName="Minimum Plots for an Ecodivision's Own Parameters" dataType="Integer" defaultValue="5" validationType="WholeNumber" validationCondition="GreaterEqual" formula1="1"/>
		<column name="MaximumAge" displayName="Maximum Age (yr)" dataType="Integer" defaultValue="300" validationType="WholeNumber" validationCondition="Greater" formula1="10"/>
		<column name="MinInventoryYear" displayName="First FIA Inventory Year" dataType="Integer" defaultValue="1997"/>
		<column name="VolumeCapQuantile" displayName="Volume Outlier Cap (quantile within type group)" dataType="Double" defaultValue="0.999"/>
	</dataSheet>

	<dataSheet name="MerchantableVolumeCurve" displayName="Merchantable Volume Curves">
		<column name="StratumId" displayName="Ecodivision" dataType="Integer" validationType="Datasheet" formula1="stsim_Stratum" allowDbNull="False"/>
		<column name="StateClassId" displayName="State Class" dataType="Integer" validationType="Datasheet" formula1="stsim_StateClass" allowDbNull="False"/>
		<column name="Age" dataType="Integer"/>
		<column name="MerchantableVolume" displayName="Merchantable Volume (m3/ha)" dataType="Double" format="0.0"/>
	</dataSheet>

	<dataSheet name="CarbonCurve" displayName="Live-Tree Carbon Curves (CBM pools)">
		<column name="StratumId" displayName="Ecodivision" dataType="Integer" validationType="Datasheet" formula1="stsim_Stratum" allowDbNull="False"/>
		<column name="StateClassId" displayName="State Class" dataType="Integer" validationType="Datasheet" formula1="stsim_StateClass" allowDbNull="False"/>
		<column name="Age" dataType="Integer"/>
		<column name="Merchantable" displayName="Merchantable (Mg C/ha)" dataType="Double" format="0.00"/>
		<column name="Foliage" displayName="Foliage (Mg C/ha)" dataType="Double" format="0.00"/>
		<column name="Other" displayName="Other Wood (Mg C/ha)" dataType="Double" format="0.00"/>
		<column name="CoarseRoots" displayName="Coarse Roots (Mg C/ha)" dataType="Double" format="0.00"/>
		<column name="FineRoots" displayName="Fine Roots (Mg C/ha)" dataType="Double" format="0.00"/>
		<column name="TotalLive" displayName="Total Live (Mg C/ha)" dataType="Double" format="0.00"/>
	</dataSheet>

	<dataSheet name="OutputCarbonParameter" displayName="Carbon Curve Parameters">
		<column name="StratumId" displayName="Ecodivision" dataType="Integer" validationType="Datasheet" formula1="stsim_Stratum"/>
		<column name="StateClassId" displayName="State Class" dataType="Integer" validationType="Datasheet" formula1="stsim_StateClass"/>
		<column name="Method" dataType="String"/>
		<column name="Plots" dataType="Integer"/>
		<column name="A" displayName="A (Mg C/ha)" dataType="Double" format="0.0"/>
		<column name="k" dataType="Double"/>
		<column name="c" dataType="Double" format="0.000"/>
		<column name="FoliageShare0" displayName="Foliage Share, Young" dataType="Double" format="0.000"/>
		<column name="FoliageShareMature" displayName="Foliage Share, Mature" dataType="Double" format="0.000"/>
		<column name="FoliageShareTau" displayName="Foliage Share Time Constant (yr)" dataType="Double" format="0.0"/>
		<column name="RootShare0" displayName="Root Share, Young" dataType="Double" format="0.000"/>
		<column name="RootShareMature" displayName="Root Share, Mature" dataType="Double" format="0.000"/>
		<column name="RootShareTau" displayName="Root Share Time Constant (yr)" dataType="Double" format="0.0"/>
		<column name="MerchCarbonDensity" displayName="Merchantable Carbon Density (Mg C/m3; FIA wood + bark)" dataType="Double" format="0.000"/>
		<column name="MerchCappedAges" displayName="Ages Where Merchantable Was Capped" dataType="Integer"/>
	</dataSheet>

	<dataSheet name="OutputGrowthParameter" displayName="Growth Curve Parameters">
		<column name="StratumId" displayName="Ecodivision" dataType="Integer" validationType="Datasheet" formula1="stsim_Stratum"/>
		<column name="StateClassId" displayName="State Class" dataType="Integer" validationType="Datasheet" formula1="stsim_StateClass"/>
		<column name="Method" dataType="String"/>
		<column name="Plots" dataType="Integer"/>
		<column name="Lag" displayName="Lag (yr)" dataType="Double" format="0.0"/>
		<column name="LagSource" displayName="Lag Source" dataType="String"/>
		<column name="A" displayName="A (m3/ha)" dataType="Double" format="0.0"/>
		<column name="k" dataType="Double"/>
		<column name="c" dataType="Double" format="0.000"/>
		<column name="VolumeAtMaxAge" displayName="Volume at Maximum Age (m3/ha)" dataType="Double" format="0.0"/>
		<column name="FiaTypeGroups" displayName="FIA Type Groups" dataType="String"/>
	</dataSheet>

	<dataSheet name="OutputDecayCalibration" displayName="Decay Calibration">
		<column name="StratumId" displayName="Ecodivision" dataType="Integer" validationType="Datasheet" formula1="stsim_Stratum"/>
		<column name="StateClassId" displayName="State Class" dataType="Integer" validationType="Datasheet" formula1="stsim_StateClass"/>
		<column name="Level" displayName="Fitted At" dataType="String"/>
		<column name="Plots" displayName="FIA Plots" dataType="Integer"/>
		<column name="ReturnInterval" displayName="Spin-up Return Interval (yr)" dataType="Integer"/>
		<column name="SnagDecayMultiplier" displayName="Snag Decay Multiplier" dataType="Double" format="0.000"/>
		<column name="DownWoodDecayMultiplier" displayName="Down Wood Decay Multiplier" dataType="Double" format="0.000"/>
		<column name="ForestFloorDecayMultiplier" displayName="Forest Floor Decay Multiplier" dataType="Double" format="0.000"/>
		<column name="SoilDecayMultiplier" displayName="Soil Decay Multiplier" dataType="Double" format="0.000"/>
		<column name="ClearcutShare" displayName="Last Disturbance Clearcut Share" dataType="Double" format="0.00"/>
		<column name="SoilTarget" displayName="gSSURGO Soil Target (Mg C/ha)" dataType="Double" format="0.0" isOptional="True"/>
		<column name="SoilSource" displayName="Soil Multiplier Source" dataType="String"/>
	</dataSheet>

	<dataSheet name="InitialStockCurve" displayName="Initial Stock Curves (spin-up)">
		<column name="StratumId" displayName="Ecodivision" dataType="Integer" validationType="Datasheet" formula1="stsim_Stratum" allowDbNull="False"/>
		<column name="StateClassId" displayName="State Class" dataType="Integer" validationType="Datasheet" formula1="stsim_StateClass" allowDbNull="False"/>
		<column name="TransitionGroupId" displayName="Last Disturbance" dataType="Integer" validationType="Datasheet" formula1="stsim_TransitionGroup" allowDbNull="False"/>
		<column name="Age" dataType="Integer"/>
		<column name="Merchantable" displayName="Merchantable (Mg C/ha)" dataType="Double" format="0.00"/>
		<column name="Other" displayName="Other Wood (Mg C/ha)" dataType="Double" format="0.00"/>
		<column name="Foliage" displayName="Foliage (Mg C/ha)" dataType="Double" format="0.00"/>
		<column name="FineRoots" displayName="Fine Roots (Mg C/ha)" dataType="Double" format="0.00"/>
		<column name="CoarseRoots" displayName="Coarse Roots (Mg C/ha)" dataType="Double" format="0.00"/>
		<column name="AGVF" displayName="DOM AG Very Fast (Mg C/ha)" dataType="Double" format="0.00"/>
		<column name="BGVF" displayName="DOM BG Very Fast (Mg C/ha)" dataType="Double" format="0.00"/>
		<column name="AGF" displayName="DOM AG Fast (Mg C/ha)" dataType="Double" format="0.00"/>
		<column name="BGF" displayName="DOM BG Fast (Mg C/ha)" dataType="Double" format="0.00"/>
		<column name="AGM" displayName="DOM AG Medium (Mg C/ha)" dataType="Double" format="0.00"/>
		<column name="AGS" displayName="DOM AG Slow (Mg C/ha)" dataType="Double" format="0.00"/>
		<column name="BGS" displayName="DOM BG Slow (Mg C/ha)" dataType="Double" format="0.00"/>
		<column name="SnagStem" displayName="Snag Stem (Mg C/ha)" dataType="Double" format="0.00"/>
		<column name="SnagBranch" displayName="Snag Branch (Mg C/ha)" dataType="Double" format="0.00"/>
		<column name="TotalLive" displayName="Total Live (Mg C/ha)" dataType="Double" format="0.00"/>
		<column name="TotalDOM" displayName="Total DOM (Mg C/ha)" dataType="Double" format="0.00"/>
	</dataSheet>

	<dataSheet name="OutputNlcdAnnual" displayName="Annual NLCD (model grid)">
		<column name="Year" dataType="Integer"/>
		<column name="FileName" displayName="NLCD Land Cover" dataType="String" isExternalFile="True" isRaster="True" externalFileFilter="GeoTIFF Files (*.tif)|*.tif"/>
	</dataSheet>

	<dataSheet name="OutputLandCoverLayers" displayName="Land Cover Layers" isSingleRow="True">
		<column name="ForestTypeFileName" displayName="Forest Type (EVT)" dataType="String" isExternalFile="True" isRaster="True" externalFileFilter="GeoTIFF Files (*.tif)|*.tif"/>
		<column name="GrassShrubFileName" displayName="Grassland/Shrubland Type (RCMAP)" dataType="String" isExternalFile="True" isRaster="True" externalFileFilter="GeoTIFF Files (*.tif)|*.tif"/>
		<column name="WetlandFileName" displayName="Wetland Type (C-CAP)" dataType="String" isExternalFile="True" isRaster="True" externalFileFilter="GeoTIFF Files (*.tif)|*.tif"/>
		<column name="EverForestFileName" displayName="Forest in Any Year (NLCD)" dataType="String" isExternalFile="True" isRaster="True" externalFileFilter="GeoTIFF Files (*.tif)|*.tif"/>
	</dataSheet>

	<dataSheet name="OutputReturnInterval" displayName="Spin-up Return Intervals">
		<column name="StratumId" displayName="Ecodivision" dataType="Integer" validationType="Datasheet" formula1="stsim_Stratum"/>
		<column name="StateClassId" displayName="State Class" dataType="Integer" validationType="Datasheet" formula1="stsim_StateClass"/>
		<column name="ReturnInterval" displayName="Replacement-Fire Return Interval (yr)" dataType="Integer"/>
		<column name="Cells" dataType="Integer"/>
	</dataSheet>

	<dataSheet name="OutputSoilTarget" displayName="Soil Carbon Targets (gSSURGO)">
		<column name="StratumId" displayName="Ecodivision" dataType="Integer" validationType="Datasheet" formula1="stsim_Stratum"/>
		<column name="StateClassId" displayName="State Class" dataType="Integer" validationType="Datasheet" formula1="stsim_StateClass"/>
		<column name="SoilTarget" displayName="Mean Soil Organic Carbon (Mg C/ha)" dataType="Double" format="0.0"/>
		<column name="Cells" dataType="Integer"/>
	</dataSheet>

	<dataSheet name="OutputStateClassSummary" displayName="State Class Summary">
		<column name="StateClassId" displayName="State Class" dataType="Integer" validationType="Datasheet" formula1="stsim_StateClass"/>
		<column name="Cells" dataType="Integer"/>
		<column name="MeanAge" displayName="Mean Age (yr)" dataType="Double" format="0.0"/>
	</dataSheet>

	<dataSheet name="OutputGrowthReport" displayName="Growth Curve Report" isSingleRow="True">
		<column name="FileName" displayName="Report (PDF)" dataType="String" isExternalFile="True" isRaster="False" externalFileFilter="PDF Files (*.pdf)|*.pdf"/>
	</dataSheet>

	<dataSheet name="OutputStrataSummary" displayName="Strata Summary">
		<column name="Level" dataType="String"/>
		<column name="Name" dataType="String"/>
		<column name="Id" dataType="Integer"/>
		<column name="Cells" dataType="Integer"/>
	</dataSheet>

	<dataSheet name="OutputValidation" displayName="Validation">
		<column name="Stage" dataType="String"/>
		<column name="Check" dataType="String"/>
		<column name="Status" dataType="String"/>
		<column name="Detail" dataType="String" isOptional="True"/>
	</dataSheet>

	<!-- =================================================================================================== -->
	<!-- TRANSFORMERS                                                                                        -->
	<!-- =================================================================================================== -->

	<transformer name="StudyArea" displayName="1 - Study Area and Strata" isRunnable="True" programName="Rscript" programArguments="src/1-study-area.R" condaEnv="lucasCore.yml" condaEnvVersion="1">
		<dataSheet name="BuildOptions" type="Input"/>
		<dataSheet name="stsim_InitialConditionsSpatial" type="Both"/>
		<dataSheet name="OutputStrataSummary" type="Output"/>
		<dataSheet name="OutputValidation" type="Output"/>
	</transformer>

	<transformer name="GrowthCurves" displayName="2 - Fit Growth Curves" isRunnable="True" programName="Rscript" programArguments="src/2-growth-curves.R" condaEnv="lucasCore.yml" condaEnvVersion="1">
		<dataSheet name="GrowthOptions" type="Input"/>
		<dataSheet name="MerchantableVolumeCurve" type="Output"/>
		<dataSheet name="CarbonCurve" type="Output"/>
		<dataSheet name="OutputGrowthParameter" type="Output"/>
		<dataSheet name="OutputCarbonParameter" type="Output"/>
		<dataSheet name="OutputGrowthReport" type="Output"/>
		<dataSheet name="OutputValidation" type="Output"/>
	</transformer>

	<transformer name="CarbonFlows" displayName="3 - Carbon Flows" isRunnable="True" programName="Rscript" programArguments="src/3-carbon-flows.R" condaEnv="lucasCore.yml" condaEnvVersion="1">
		<dataSheet name="CarbonCurve" type="Input"/>
		<dataSheet name="stsim_FlowPathwayDiagram" type="Input"/>
		<dataSheet name="OutputReturnInterval" type="Input"/>
		<dataSheet name="OutputSoilTarget" type="Input"/>
		<dataSheet name="stsim_FlowPathway" type="Output"/>
		<dataSheet name="stsim_FlowMultiplier" type="Output"/>
		<dataSheet name="stsim_StateAttributeValue" type="Output"/>
		<dataSheet name="OutputDecayCalibration" type="Output"/>
		<dataSheet name="OutputValidation" type="Output"/>
	</transformer>

	<transformer name="InitialStocks" displayName="4 - Spin-up and Initial Stocks" isRunnable="True" programName="Rscript" programArguments="src/4-initial-stocks.R" condaEnv="lucasCore.yml" condaEnvVersion="1">
		<dataSheet name="CarbonCurve" type="Input"/>
		<dataSheet name="OutputDecayCalibration" type="Input"/>
		<dataSheet name="stsim_FlowMultiplier" type="Input"/>
		<dataSheet name="InitialStockCurve" type="Output"/>
		<dataSheet name="OutputValidation" type="Output"/>
	</transformer>

	<transformer name="InitialConditions" displayName="5 - Initial Conditions" isRunnable="True" programName="Rscript" programArguments="src/5-initial-conditions.R" condaEnv="lucasCore.yml" condaEnvVersion="1">
		<dataSheet name="BuildOptions" type="Input"/>
		<dataSheet name="stsim_InitialConditionsSpatial" type="Both"/>
		<dataSheet name="OutputNlcdAnnual" type="Output"/>
		<dataSheet name="OutputLandCoverLayers" type="Output"/>
		<dataSheet name="OutputReturnInterval" type="Output"/>
		<dataSheet name="OutputSoilTarget" type="Output"/>
		<dataSheet name="OutputStateClassSummary" type="Output"/>
		<dataSheet name="OutputValidation" type="Output"/>
	</transformer>

	<!-- =================================================================================================== -->
	<!-- LAYOUTS                                                                                             -->
	<!-- =================================================================================================== -->

	<layout type="Project" appendTo="stsim_Advanced">
		<group name="lucasCoreGroup" displayName="LUCAS Core">
			<item name="DataSource"/>
			<item name="StratumSource"/>
		</group>
	</layout>

	<layout type="Scenario" appendTo="stsim_Advanced">
		<group name="lucasCoreGroup" displayName="LUCAS Core">
			<item name="BuildOptions"/>
			<item name="GrowthOptions"/>
			<item name="MerchantableVolumeCurve"/>
			<item name="CarbonCurve"/>
			<item name="InitialStockCurve"/>
			<group name="lucasCoreResults" displayName="Build Results">
				<item name="OutputStrataSummary"/>
				<item name="OutputStateClassSummary"/>
				<item name="OutputLandCoverLayers"/>
				<item name="OutputNlcdAnnual"/>
				<item name="OutputReturnInterval"/>
				<item name="OutputSoilTarget"/>
				<item name="OutputGrowthParameter"/>
				<item name="OutputCarbonParameter"/>
				<item name="OutputDecayCalibration"/>
				<item name="OutputGrowthReport"/>
				<item name="OutputValidation"/>
			</group>
		</group>
	</layout>

	<updateProvider className="SyncroSim.Core.XMLUpdateProvider" classAssembly="SyncroSim.Core"/>
</package>
